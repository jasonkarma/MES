# --- Odoo connection ---------------------------------------------------------
ODOO_URL=http://localhost:8069
ODOO_DB=mes_lab
ODOO_USER=admin
ODOO_PASSWORD=admin

# Alias read by the existing src/ package (src/config.py uses ODOO_USERNAME)
ODOO_USERNAME=admin

# --- OpenAI ------------------------------------------------------------------
# Fill in your OpenAI API key. Keep this file blank and put the real key in .env.
OPENAI_API_KEY=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

# OpenAI model name
OPENAI_MODEL=gpt-4o-mini

# --- Chatter behaviour -------------------------------------------------------
# mail.mt_note    -> internal note (yellow, no follower notification) [default]
# mail.mt_comment -> regular comment
CHATTER_SUBTYPE=mail.mt_note

# --- Watch mode (python triage.py --watch) -----------------------------------
# All optional; the matching CLI flag overrides the value here.
#
# Seconds between polls of new mail.message rows on mrp.production.
WATCH_INTERVAL=10
# Max chatter messages handled per poll.
WATCH_BATCH_SIZE=20
# Crash-safe checkpoint: last processed mail.message id + dedupe rings.
# Delete it to make the watcher adopt the current chatter tip as its cursor.
WATCH_STATE_FILE=logs/watch_state.json
# Append-only JSONL audit trail of messages that could not be triaged.
WATCH_FAILURES_FILE=logs/triage_watch_failures.jsonl
# skip = dead-letter an unprocessable note and keep going (poison-message isolation)
# halt = stop the watcher immediately so you can debug it
WATCH_ON_ERROR=skip
# Which mail.message.message_type values count as operator input.
# 'comment'/'email' = human notes; Odoo tracking noise is 'notification'.
WATCH_MESSAGE_TYPES=comment,email

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
