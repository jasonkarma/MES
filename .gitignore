# Logs
logs/*.jsonl
logs/*.log
*.log

# Watch-mode runtime state (checkpoint + lock + quarantined/backup copies).
# Local to each machine: a cursor is meaningless on another host, and a stale
# checkpoint must never be inherited by a fresh clone.
logs/watch_state.json*
logs/triage_watch_failures.jsonl
logs/watch.log

